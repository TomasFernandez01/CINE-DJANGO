# recuperado (revisión final): este archivo había desaparecido en el zip
# de la última integración. Se reconstruyó leyendo directamente qué
# variables usa configuracion/settings.py hoy (no son solo las de Google
# que dejó Hilo 2 -- se sumaron las 4 de EMAIL_* que agregó Hilo 1).
#
# Copiá este archivo a uno llamado ".env" (sin ".example") en la misma
# carpeta, y completá ahí los valores reales. Ese ".env" NO se commitea
# (ver .gitignore).
#
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)

# --- Django ---
# IMPORTANTE: SECRET_KEY no tiene valor de fallback en settings.py -- si
# falta acá, Django directamente no arranca (ImproperlyConfigured). Generar
# una clave nueva, no reusar ninguna que haya estado hardcodeada en el
# código en algún momento (esa ya puede estar expuesta si el repo se
# commiteó alguna vez así):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# API key de themoviedb.org (para el catálogo de películas). Tampoco tiene
# fallback -- si falta, todo lo que dependa de TMDB (importar/actualizar
# películas) va a fallar.
TMDB_API_KEY=

# --- Google Sign-In (Hilo 2) ---
# Se generan en Google Cloud Console > APIs y servicios > Credenciales >
# Crear credenciales > ID de cliente de OAuth. Ver
# reportes/FINAL/REPORTE_Jager_Hilo2.md para el paso a paso completo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email / Gmail SMTP (Hilo 1) ---
# Ver reportes/FINAL/thomp_Hilo1_reporte.md. EMAIL_HOST_PASSWORD es la
# "contraseña de aplicación" de 16 dígitos de Gmail (Google Account >
# Seguridad > Contraseñas de aplicaciones), NO la contraseña normal de la
# cuenta -- necesita verificación en 2 pasos activada primero.
#
# OJO: esto es el fallback GLOBAL que usa Django cuando una sede no tiene
# su propia configuración cargada en Panel > Administración >
# Configuración General. La config del Panel, si existe para una sede,
# tiene prioridad sobre estas variables (ver utils/email_utils.py).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
