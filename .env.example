# Copiá este archivo a uno llamado ".env" (sin ".example") en la misma carpeta, y completá ahí los valores reales. Ese ".env" NO se commitea (ver .gitignore).
#   cp .env.example .env      (Linux/Mac)   //   copy .env.example .env    (Windows)

# --- Django ---
# IMPORTANTE: SECRET_KEY no tiene valor de fallback en settings.py -- si falta acá, Django directamente no arranca (ImproperlyConfigured). Generar una clave nueva, no reusar ninguna que haya estado hardcodeada en el código en algún momento (esa ya puede estar expuesta si el repo se commiteó alguna vez así):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# nuevo (Hilo 3 - Deploy): en local dejar en blanco o en False -- el default en settings.py ya es False. En Render, dejar en False también (o directamente no cargar esta variable ahí) -- si algún día hace falta debuggear un error 500 en producción, se puede prender momentáneamente desde el dashboard de Render, pero apagarlo apenas se termina de mirar.
DEBUG=False

# nuevo (Hilo 3 - Deploy): en local se puede dejar vacío. En Render, cargar el dominio que asigna Render (ej. midominio.onrender.com), y el dominio propio si se llega a conectar uno (separados por coma, sin espacios: midominio.onrender.com,www.midominio.com).
ALLOWED_HOSTS=

# nuevo (Hilo 3 - Deploy): mismo dominio que ALLOWED_HOSTS pero con el esquema completo (https://) -- Django lo exige así para el chequeo de CSRF. Ej: https://midominio.onrender.com
CSRF_TRUSTED_ORIGINS=

# nuevo (Hilo 3 - Deploy): en local se deja vacío -- si no está seteada, el proyecto usa SQLite como siempre (ver configuracion/settings.py). En Render, esta variable la inyecta sola el servicio de Postgres al conectarlo -- no hay que armarla a mano ahí.
DATABASE_URL=

# nuevo (Hilo 3 - Deploy): credenciales de Cloudinary (almacenamiento de imágenes -- posters de películas, imágenes de combos -- porque Render borra el filesystem local en cada redeploy). Se consiguen creando una cuenta gratis en https://cloudinary.com -- una vez logueado, el "Dashboard" de la cuenta muestra las 3 directamente (Cloud Name, API Key, API Secret), sin ningún paso extra.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# API key de themoviedb.org (para el catálogo de películas). Tampoco tiene fallback -- si falta, todo lo que dependa de TMDB (importar/actualizar películas) va a fallar.
TMDB_API_KEY=

# --- Google Sign-In (Hilo 2) ---
# Se generan en Google Cloud Console > APIs y servicios > Credenciales > Crear credenciales > ID de cliente de OAuth. Ver reportes/FINAL/REPORTE_Jager_Hilo2.md para el paso a paso completo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email / Gmail SMTP (Hilo 1) ---
# Ver reportes/FINAL/thomp_Hilo1_reporte.md. EMAIL_HOST_PASSWORD es la "contraseña de aplicación" de 16 dígitos de Gmail (Google Account > Seguridad > Contraseñas de aplicaciones), NO la contraseña normal de la cuenta -- necesita verificación en 2 pasos activada primero.

# OJO: esto es el fallback GLOBAL que usa Django cuando una sede no tiene su propia configuración cargada en Panel > Administración > Configuración General. La config del Panel, si existe para una sede, tiene prioridad sobre estas variables (ver utils/email_utils.py).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
